<Window x:Class="KioskSender.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KioskSenderApp — Zeitmanager &amp; Gruppenmanager"
        Height="820" Width="1360"
        MinHeight="640" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Kopfzeile ============================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                            Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="KioskSenderApp" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Zeitmanager &amp; Gruppenmanager" Margin="12,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ClockText}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Zeitmanager aktiv" Margin="0,0,16,0"
                              IsChecked="{Binding SchedulerEnabled}"
                              ToolTip="Wenn ausgeschaltet, löst der Zeitplan keine Aktionen mehr aus." />
                    <CheckBox Content="Testbetrieb" Margin="0,0,16,0"
                              IsChecked="{Binding DryRun}"
                              ToolTip="Befehle werden nur protokolliert, aber nicht ausgeführt." />
                    <Button Content="Status prüfen" Command="{Binding RefreshStatusCommand}" />
                    <Button Content="Speichern" Style="{StaticResource AccentButton}"
                            Command="{Binding SaveCommand}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Registerkarten ============================== -->
        <TabControl Grid.Row="1" TabStripPlacement="Left">

            <!-- ================================================================ Übersicht -->
            <TabItem Header="Übersicht">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0"
                                         Text="{Binding PcFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filtert nach Name, Host, Gruppe oder Notiz." />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Suchen: Name, Host, Gruppe" />
                            </Grid>

                            <DataGrid x:Name="PcGrid" Grid.Row="1"
                                      ItemsSource="{Binding PcsView}"
                                      SelectedItem="{Binding SelectedPc, Mode=TwoWay}"
                                      SelectionChanged="OnPcSelectionChanged"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="38">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                                          IsEnabled="{Binding Enabled}"
                                                          HorizontalAlignment="Center" Margin="0"
                                                          ToolTip="Angehakte PCs sind das Ziel der Aktionen rechts." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="" Width="34">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="10" Height="10" CornerRadius="5"
                                                        HorizontalAlignment="Center"
                                                        Background="{Binding State, Converter={StaticResource HostStateToBrush}}"
                                                        ToolTip="{Binding StatusText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Name" Width="1.4*" Binding="{Binding DisplayName, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Host / IP" Width="1.2*" Binding="{Binding Host, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Zeigt" Width="1.3*" Binding="{Binding ContentText, Mode=OneWay}" />

                                    <DataGridTemplateColumn Header="Gruppe" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0"
                                                            Background="{Binding GroupColor, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding GroupName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Zeitfenster" Width="1.6*" Binding="{Binding ScheduleText, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Erreichbarkeit" Width="1.4*" Binding="{Binding StatusText, Mode=OneWay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Sender -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Senden" Style="{StaticResource HeadlineText}" />

                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Die Aktionen treffen die in der Tabelle angehakten PCs. Ist nichts angehakt, gilt die markierte Zeile." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Alle" Command="{Binding ChooseAllPcsCommand}" />
                                    <Button Content="Keine" Command="{Binding ChooseNoPcsCommand}" />
                                    <Button Content="Gruppe" Command="{Binding ChooseGroupPcsCommand}" Margin="0" />
                                </StackPanel>

                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="5"
                                        Padding="9,7" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding TargetSummary}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}" />
                                </Border>

                                <TextBlock Text="Nachricht" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                         VerticalContentAlignment="Top"
                                         ToolTip="Wird als Windows-Meldung (msg.exe) auf dem Zielrechner angezeigt." />

                                <Button Content="Nachricht senden" Style="{StaticResource AccentButton}"
                                        Command="{Binding SendMessageCommand}" Margin="0,0,0,14" />

                                <Separator />

                                <TextBlock Text="Aktionen" Style="{StaticResource CaptionText}" Margin="0,6,0,6" />
                                <Button Content="Benutzer abmelden" Command="{Binding SendLogoffCommand}" Margin="0,0,0,6" />
                                <Button Content="Neu starten" Command="{Binding SendRestartCommand}" Margin="0,0,0,6" />
                                <Button Content="Herunterfahren" Style="{StaticResource DangerButton}"
                                        Command="{Binding SendShutdownCommand}" Margin="0,0,0,6" />
                                <Button Content="Countdown abbrechen" Command="{Binding SendAbortCommand}" Margin="0,0,0,6"
                                        ToolTip="Bricht ein laufendes Herunterfahren auf den Zielrechnern ab." />
                                <Button Content="Eigener Befehl" Command="{Binding SendCustomCommand}" Margin="0,0,0,6"
                                        ToolTip="Führt den in den Einstellungen hinterlegten Befehl aus." />

                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                           Text="Herunterfahren und Neustart fragen vor der Ausführung nach. Im Testbetrieb wird nichts ausgeführt." />

                                <!-- Ergebnis der letzten Aktion, je Rechner eine Zeile -->
                                <ItemsControl ItemsSource="{Binding ActionResults}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        Margin="0,0,8,0" VerticalAlignment="Top"
                                                        Background="{Binding IsGood, Converter={StaticResource BoolToBrush}}" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Target}" FontSize="12" />
                                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ Gruppen -->
            <TabItem Header="Gruppen &amp; PCs">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Gruppenliste -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Gruppen" Style="{StaticResource HeadlineText}" />

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Groups}"
                                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                    Margin="0,0,9,0" VerticalAlignment="Center"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Neue Gruppe" Command="{Binding AddGroupCommand}" />
                                <Button Content="Entfernen" Command="{Binding RemoveGroupCommand}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Gruppendetails und Mitglieder -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Gruppe bearbeiten" Style="{StaticResource HeadlineText}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Name" Style="{StaticResource CaptionText}" />
                                        <TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Farbe (#RRGGBB)" Style="{StaticResource CaptionText}" />
                                        <TextBox Text="{Binding SelectedGroup.ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Zeitplan der Gruppe" Style="{StaticResource CaptionText}" />
                                        <ComboBox ItemsSource="{Binding ScheduleChoices}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedGroupScheduleId, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Notiz" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding SelectedGroup.Note, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="5"
                                        Padding="9,7" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedGroup.WindowText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <DataGrid x:Name="MemberGrid" Grid.Row="1"
                                      ItemsSource="{Binding ManagedPcsView}"
                                      SelectedItem="{Binding SelectedPc, Mode=TwoWay}"
                                      SelectionChanged="OnPcSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Aktiv" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" Margin="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Name" Width="1.3*"
                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Host / IP" Width="1.2*"
                                                        Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Gruppe" Width="*" IsReadOnly="True"
                                                        Binding="{Binding GroupName, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Notiz" Width="*"
                                                        Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="PC hinzufügen" Command="{Binding AddPcCommand}" />
                                <Button Content="Duplizieren" Command="{Binding DuplicatePcCommand}" />
                                <Button Content="Entfernen" Command="{Binding RemovePcCommand}" />
                                <Button Content="Auswahl dieser Gruppe zuordnen"
                                        Command="{Binding AssignSelectedToGroupCommand}" Margin="0"
                                        ToolTip="Ordnet alle in der Tabelle markierten PCs der links gewählten Gruppe zu." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- PC-Details -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="PC bearbeiten" Style="{StaticResource HeadlineText}" />

                                <TextBlock Text="Kein PC ausgewählt."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding HasSelectedPc, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <StackPanel Visibility="{Binding HasSelectedPc, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Anzeigename" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding SelectedPc.Name, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Hostname oder IP-Adresse" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding SelectedPc.Host, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding SelectedPc.HostHint}"
                                               Foreground="{StaticResource WarningBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding SelectedPc.HostHint, Converter={StaticResource StringToVisibility}}" />

                                    <TextBlock Text="Gruppe" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding GroupChoices}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedPcGroupId, Mode=TwoWay}" />

                                    <TextBlock Text="Eigener Zeitplan (überschreibt die Gruppe)" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding ScheduleChoices}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedPcScheduleId, Mode=TwoWay}" />

                                    <CheckBox Content="PC aktiv (wird überwacht und gesteuert)"
                                              IsChecked="{Binding SelectedPc.Enabled}" />

                                    <TextBlock Text="Notiz" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding SelectedPc.Note, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                             VerticalContentAlignment="Top" />

                                    <Separator />

                                    <TextBlock Text="Wirksamer Zeitplan" Style="{StaticResource CaptionText}" Margin="0,6,0,3" />
                                    <TextBlock Text="{Binding SelectedPc.ScheduleName}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedPc.ScheduleText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedPc.StatusText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ Inhalte -->
            <TabItem Header="Inhalte senden">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Schritt 1: Ordner -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" Style="{StaticResource StepBadgeText}" />
                                </Border>
                                <TextBlock Text="Ordner wählen" Style="{StaticResource HeadlineText}" Margin="0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Jeder Unterordner ist eine eigene Wiedergabeliste. Die Dateien darin laufen der Reihe nach — nach Namen sortiert (Bild1, Bild2, Bild10)." />

                                <TextBox Text="{Binding MediaRootPath, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Hauptordner mit allen Medien." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Ordner wählen…" Command="{Binding BrowseMediaFolderCommand}" />
                                    <Button Content="Neu einlesen" Command="{Binding RefreshLibraryCommand}" />
                                    <Button Content="Öffnen" Command="{Binding OpenMediaFolderCommand}" Margin="0"
                                            ToolTip="Öffnet den Ordner im Explorer — dort Dateien hineinlegen." />
                                </StackPanel>
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding LibraryFolders}"
                                     SelectedItem="{Binding SelectedLibraryFolder, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{Binding Indent}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="3" Text="{Binding LibraryStatus}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>

                    <!-- Schritt 2: Inhalt prüfen -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" Style="{StaticResource StepBadgeText}" />
                                </Border>
                                <TextBlock Text="Inhalt prüfen" Style="{StaticResource HeadlineText}" Margin="0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{Binding PlaylistName}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlaylistSummary}" TextWrapping="Wrap" Margin="0,3,0,10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding PlaylistItems}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="40" Binding="{Binding Position, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Datei" Width="2*" Binding="{Binding FileName, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Art" Width="*" Binding="{Binding KindText, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Dauer" Width="*" Binding="{Binding DurationText, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Größe" Width="*" Binding="{Binding SizeText, Mode=OneWay}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Bild zeigen für (Sek.)" Style="{StaticResource CaptionText}" />
                                        <TextBox Width="80" HorizontalAlignment="Left"
                                                 Text="{Binding DefaultImageSeconds, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,16,8">
                                        <CheckBox Content="Endlos wiederholen" IsChecked="{Binding PlaylistLoop}" Margin="0,0,0,4" />
                                        <CheckBox Content="Reihenfolge mischen" IsChecked="{Binding PlaylistShuffle}" Margin="0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                               Style="{StaticResource CaptionText}"
                                               Text="Videos laufen immer bis zum Ende. PowerPoint startet als Bildschirmpräsentation." />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Schritt 3: Empfänger und senden -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="3" Style="{StaticResource StepBadgeText}" />
                                </Border>
                                <TextBlock Text="An welche PCs?" Style="{StaticResource HeadlineText}" Margin="0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Alle" Command="{Binding ChooseAllPcsCommand}" />
                                <Button Content="Keine" Command="{Binding ChooseNoPcsCommand}" />
                                <Button Content="Gewählte Gruppe" Command="{Binding ChooseGroupPcsCommand}" Margin="0"
                                        ToolTip="Hakt alle PCs der Gruppe an, die unter „Gruppen &amp; PCs“ ausgewählt ist." />
                            </StackPanel>

                            <ListBox Grid.Row="2" ItemsSource="{Binding Pcs}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                                      IsEnabled="{Binding Enabled}" />

                                            <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="{Binding State, Converter={StaticResource HostStateToBrush}}"
                                                    ToolTip="{Binding StatusText}" />

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding ContentText}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding LastSentText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="{Binding ChosenPcSummary}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{StaticResource TextMutedBrush}" />

                                <!--
                                    Mode=OneWay ist Pflicht: ProgressBar.Value bindet sonst
                                    beidseitig und WPF lehnt eine Eigenschaft ohne
                                    öffentlichen Setter beim Aufbau des Fensters ab.
                                -->
                                <ProgressBar Value="{Binding DeployPercent, Mode=OneWay}" Maximum="100"
                                             Visibility="{Binding IsDeploying, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding DeployStatus}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding DeployStatus, Converter={StaticResource StringToVisibility}}" />

                                <Button Content="Jetzt an die angehakten PCs senden"
                                        Style="{StaticResource BigActionButton}"
                                        Command="{Binding SendContentCommand}" />

                                <Button Content="Übertragung abbrechen"
                                        Command="{Binding CancelSendContentCommand}"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding IsDeploying, Converter={StaticResource BoolToVisibility}}" />

                                <Separator />

                                <TextBlock Text="Feste Zuordnung" Style="{StaticResource CaptionText}" Margin="0,6,0,4" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Damit merkt sich jeder PC, welchen Ordner er zeigt. Danach genügt ein Klick auf „Alle Zuordnungen senden“ — anhaken entfällt." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Angehakten zuordnen" Command="{Binding AssignToChosenPcsCommand}"
                                            ToolTip="Der links gewählte Ordner wird den angehakten PCs fest zugeordnet." />
                                    <Button Content="Der Gruppe zuordnen" Command="{Binding AssignToGroupCommand}" Margin="0"
                                            ToolTip="Ordnet den Ordner der unter „Gruppen &amp; PCs“ gewählten Gruppe zu." />
                                </StackPanel>

                                <Button Content="Zuordnung aufheben" Command="{Binding ClearAssignmentCommand}"
                                        Margin="0,0,0,8" HorizontalAlignment="Left" />

                                <TextBlock Text="{Binding AssignmentSummary}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{StaticResource TextMutedBrush}" />

                                <Button Content="Alle Zuordnungen senden"
                                        Style="{StaticResource BigActionButton}"
                                        Command="{Binding SendAssignedCommand}"
                                        ToolTip="Jeder PC bekommt den Inhalt, der ihm zugeordnet ist." />

                                <!-- Ergebnis der letzten Übertragung, je Rechner eine Zeile -->
                                <ItemsControl ItemsSource="{Binding DeployResults}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                        Margin="0,0,8,0" VerticalAlignment="Top"
                                                        Background="{Binding Success, Converter={StaticResource BoolToBrush}}" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding PcName}" FontSize="12" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                           Text="Auf den Kiosk-PCs muss KioskPlayer laufen. Er merkt selbst, wenn neue Inhalte ankommen, und wechselt darauf." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ Zeitmanager -->
            <TabItem Header="Zeitmanager">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Zeitpläne" Style="{StaticResource HeadlineText}" />

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Schedules}"
                                     SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding WeekSummary}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="Neuer Zeitplan" Command="{Binding AddScheduleCommand}" Margin="0,0,0,6" />
                                <Button Content="Duplizieren" Command="{Binding DuplicateScheduleCommand}" Margin="0,0,0,6" />
                                <Button Content="Entfernen" Command="{Binding RemoveScheduleCommand}" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Kein Zeitplan ausgewählt. Links einen Zeitplan wählen oder neu anlegen."
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasSelectedSchedule, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <StackPanel Visibility="{Binding HasSelectedSchedule, Converter={StaticResource BoolToVisibility}}">

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Name des Zeitplans" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding SelectedSchedule.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Zeitplan aktiv" VerticalAlignment="Bottom"
                                                  Margin="0,0,0,14"
                                                  IsChecked="{Binding SelectedSchedule.Enabled}" />
                                    </Grid>

                                    <TextBlock Text="Öffnungszeiten je Wochentag" Style="{StaticResource HeadlineText}" Margin="0,6,0,8" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="Mehrere Zeitspannen mit Komma trennen, z. B. 08:00-12:00, 13:00-17:00. Leer lassen heißt geschlossen. Über Mitternacht: 20:00-02:00." />

                                    <ItemsControl ItemsSource="{Binding SelectedSchedule.Days}" Margin="0,4,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DayName}" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                                                             Text="{Binding RangesText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DurationText}"
                                                               Foreground="{StaticResource TextMutedBrush}" />

                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}"
                                                               Foreground="{StaticResource DangerBrush}" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Was am Ende des Zeitfensters passiert" Style="{StaticResource HeadlineText}" Margin="0,6,0,8" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Aktion" Style="{StaticResource CaptionText}" />
                                            <ComboBox ItemsSource="{Binding CloseActions}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Kind"
                                                      SelectedValue="{Binding SelectedSchedule.CloseAction, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Vorwarnung (Min.)" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding SelectedSchedule.WarnMinutesText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Mehrere Werte mit Komma, z. B. 15, 5" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="Karenz (Min.)" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding SelectedSchedule.CloseGraceMinutes, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Wartezeit nach Fensterende, bevor die Aktion läuft." />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Countdown (Sek.)" Style="{StaticResource CaptionText}" />
                                            <TextBox Text="{Binding SelectedSchedule.CloseCountdownSeconds, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Frist, die Windows dem Benutzer vor dem Herunterfahren noch lässt." />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Text der Vorwarnung" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding SelectedSchedule.WarnText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{}{minutes} wird durch die verbleibenden Minuten ersetzt." />

                                    <TextBlock Text="Meldung beim Öffnen (leer = keine Meldung)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding SelectedSchedule.OpenText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Ausnahmetage (Feiertage, Sonderzeiten)" Style="{StaticResource HeadlineText}" Margin="0,10,0,8" />

                                    <DataGrid ItemsSource="{Binding SelectedSchedule.Exceptions}"
                                              SelectedItem="{Binding SelectedException, Mode=TwoWay}"
                                              Height="170">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Datum" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" Margin="0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Geschlossen" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Closed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" Margin="0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Sonderzeiten" Width="*"
                                                                Binding="{Binding RangesText, UpdateSourceTrigger=LostFocus}" />
                                            <DataGridTextColumn Header="Notiz" Width="*"
                                                                Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Ausnahmetag hinzufügen" Command="{Binding AddExceptionCommand}" />
                                        <Button Content="Entfernen" Command="{Binding RemoveExceptionCommand}" Margin="0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ Protokoll -->
            <TabItem Header="Protokoll">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding LogEntries}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zeit" Width="140"
                                                    Binding="{Binding Timestamp, StringFormat='dd.MM. HH:mm:ss', Mode=OneWay}" />
                                <DataGridTemplateColumn Header="Ebene" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Level}"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                       FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Quelle" Width="130" Binding="{Binding Source, Mode=OneWay}" />
                                <DataGridTextColumn Header="Ziel" Width="180" Binding="{Binding Target, Mode=OneWay}" />
                                <DataGridTextColumn Header="Meldung" Width="*" Binding="{Binding Message, Mode=OneWay}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Als CSV exportieren" Command="{Binding ExportLogCommand}" />
                            <Button Content="Anzeige leeren" Command="{Binding ClearLogCommand}" Margin="0" />
                            <TextBlock Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Das vollständige Protokoll wird zusätzlich tageweise als Datei mitgeschrieben." />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================================================================ Einstellungen -->
            <TabItem Header="Einstellungen">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Betrieb" Style="{StaticResource HeadlineText}" />

                            <CheckBox Content="Zeitmanager aktiv" IsChecked="{Binding SchedulerEnabled}" />
                            <CheckBox Content="Testbetrieb — Befehle werden nur protokolliert, nicht ausgeführt"
                                      IsChecked="{Binding DryRun}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Statusprüfung alle (Sek.)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding StatusIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Countdown manuell (Sek.)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ManualCountdownSeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Meldung sichtbar (Sek.)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding MessageDisplaySeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Eigener Befehl" Style="{StaticResource HeadlineText}" Margin="0,14,0,8" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="Wird für die Aktion „Eigener Befehl“ verwendet. {host} wird durch den Zielrechner ersetzt. Beispiel für das Sperren des Bildschirms mit PsExec:" />
                            <TextBlock Style="{StaticResource CaptionText}" FontFamily="Consolas"
                                       Text="C:\Tools\PsExec.exe \\{host} -s -d rundll32.exe user32.dll,LockWorkStation" />
                            <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />

                            <TextBlock Text="Inhalte verteilen" Style="{StaticResource HeadlineText}" Margin="0,14,0,8" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="Wohin die Bilder, Videos und Präsentationen auf dem Kiosk-PC kopiert werden. {host} wird durch den jeweiligen Rechner ersetzt. Voreingestellt ist die Verwaltungsfreigabe C$ — dorthin darf, wer auf dem Zielrechner Administrator ist. Alternativ geht auch eine zentrale Freigabe, z. B. \\medienserver\kiosk\{host}." />
                            <TextBox Text="{Binding ContentTargetTemplate, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />

                            <CheckBox Content="Beim Senden nicht mehr benötigte Dateien auf dem Kiosk-PC löschen"
                                      IsChecked="{Binding RemoveObsoleteContent}" />

                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="Auf jedem Kiosk-PC muss KioskPlayer.exe laufen. Der Player liest genau diesen Ordner, merkt selbstständig, wenn neue Inhalte ankommen, und wechselt darauf — ohne Neustart." />

                            <TextBlock Text="Voraussetzungen auf den Zielrechnern" Style="{StaticResource HeadlineText}" Margin="0,14,0,8" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="Die Fernsteuerung nutzt ausschließlich Windows-Bordmittel — es muss nichts auf den Kiosk-PCs installiert werden. Damit das funktioniert, müssen alle Rechner in derselben Domäne oder Arbeitsgruppe sein, der ausführende Benutzer muss auf den Zielrechnern Administrator sein, und in der Firewall müssen „Datei- und Druckerfreigabe“ sowie „Windows-Verwaltungsinstrumentation“ freigegeben sein. Für Meldungen muss auf den Zielrechnern der Dienst „Remotedesktopdienste“ laufen." />

                            <TextBlock Text="Speicherort" Style="{StaticResource HeadlineText}" Margin="0,14,0,8" />
                            <TextBlock Text="{Binding ConfigPath}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ============================== Statuszeile ============================== -->
        <StackPanel Grid.Row="2">

            <!--
                Hinweisbalken statt Fehlerdialog: die Anwendung läuft weiter,
                die Meldung steht ruhig da und lässt sich wegklicken.
            -->
            <Border Background="#2A2118" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1,1,1,1" CornerRadius="8" Padding="12,9" Margin="0,10,0,0"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Notice}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" />

                    <Button Grid.Column="1" Content="Verstanden" Margin="12,0,0,0"
                            Command="{Binding DismissNoticeCommand}" />
                </Grid>
            </Border>

        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Prüfe…" Margin="0,0,12,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SaveStateText}" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</Window>
