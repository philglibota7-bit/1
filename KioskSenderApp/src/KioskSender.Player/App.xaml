<Application x:Class="KioskSender.Player.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
            Medien laufen auf schwarzem Grund — so stört nichts das Bild und
            Ränder fallen nicht auf. Die Warte- und Hinweisflächen dagegen sind
            hell im Klinik-Design, damit sie zur Beschilderung im Haus passen.
        -->
        <SolidColorBrush x:Key="StageBrush" Color="#000000" />
        <SolidColorBrush x:Key="InfoBackBrush" Color="#EDF2F7" />
        <SolidColorBrush x:Key="InfoCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#D2DCE5" />
        <SolidColorBrush x:Key="InfoBrush" Color="#15303F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5B7285" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0B6FA4" />
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    </Application.Resources>
</Application>
