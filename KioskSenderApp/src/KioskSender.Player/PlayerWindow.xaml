<Window x:Class="KioskSender.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KioskPlayer"
        Background="{StaticResource StageBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Height="720" Width="1280">

    <Grid>
        <!-- Bühne: Bild und Video liegen übereinander, es ist immer nur eines sichtbar. -->
        <Image x:Name="ImageStage"
               Stretch="Uniform"
               Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <MediaElement x:Name="VideoStage"
                      Stretch="Uniform"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Visibility="Collapsed" />

        <!-- Wartefläche im Klinik-Design, wenn nichts abgespielt werden kann -->
        <Border x:Name="InfoPanel" Background="{StaticResource InfoBackBrush}" Visibility="Visible">
            <Border Background="{StaticResource InfoCardBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="56,44"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Farbstreifen als ruhiger Anker, wie auf Klinik-Beschilderung -->
                    <Border Height="5" Width="120" CornerRadius="3"
                            HorizontalAlignment="Center" Margin="0,0,0,28"
                            Background="{StaticResource AccentBrush}" />

                    <TextBlock Text="KioskPlayer"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="40" FontWeight="Light"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="InfoHeadline"
                               Text="Warte auf Inhalte…"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource InfoBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,24,0,0" />

                    <TextBlock x:Name="InfoDetail"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="15"
                               LineHeight="24"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Kurze Einblendung: welcher Rechner, welche Liste, welche Taste -->
        <Border x:Name="HintPanel"
                Background="{StaticResource InfoCardBrush}"
                BorderBrush="{StaticResource InfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,11"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="22"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" CornerRadius="2" Margin="0,0,12,0"
                        Background="{StaticResource AccentBrush}" />
                <TextBlock x:Name="HintText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="14"
                           LineHeight="20"
                           Foreground="{StaticResource InfoBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
