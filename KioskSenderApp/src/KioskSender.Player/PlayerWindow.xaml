<Window x:Class="KioskSender.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KioskPlayer"
        Background="{StaticResource StageBrush}"
        WindowStartupLocation="CenterScreen"
        Height="720" Width="1280">

    <Grid>
        <!-- Bühne: Bild und Video liegen übereinander, es ist immer nur eines sichtbar. -->
        <Image x:Name="ImageStage"
               Stretch="Uniform"
               Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <MediaElement x:Name="VideoStage"
                      Stretch="Uniform"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Visibility="Collapsed" />

        <!-- Hinweisfläche, wenn nichts abgespielt werden kann -->
        <Border x:Name="InfoPanel" Background="#000000" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                <TextBlock Text="KioskPlayer"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="44" FontWeight="Light"
                           Foreground="{StaticResource InfoBrush}"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="InfoHeadline"
                           Text="Warte auf Inhalte…"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="21"
                           Foreground="{StaticResource InfoBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,26,0,0" />

                <TextBlock x:Name="InfoDetail"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- Kurz nach dem Start eingeblendet, damit man weiß, wie man wieder herauskommt -->
        <Border x:Name="HintPanel"
                Background="#CC12151C"
                CornerRadius="6"
                Padding="14,9"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="18"
                Visibility="Collapsed">
            <TextBlock x:Name="HintText"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="13"
                       Foreground="{StaticResource InfoBrush}" />
        </Border>
    </Grid>
</Window>
